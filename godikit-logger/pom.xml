    <artifactId>godikit-logger-parent</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>GodiKit Logger Parent</name>
    <description>Aggregator module of GodiKit Logger, grouping the core API artifact, the SLF4J 1.7 and SLF4J 2.x +
        Logback providers with their default configurations, and the corresponding usage examples.
    </description>
    <url>https://www.godikit.com/logger</url>

    <properties>
        <godikit.java.version>8</godikit.java.version>

        <log4j2.version>2.25.5</log4j2.version>
        <slf4j.version>1.7.36</slf4j.version>
    </properties>

    <modules>
        <module>godikit-logger</module>
        <module>godikit-logger-provider-slf4j-logback</module>
        <module>godikit-logger-provider-slf4j-logback-config</module>
        <module>godikit-logger-provider-slf4j2-logback</module>
        <module>godikit-logger-provider-slf4j2-logback-config</module>
        <module>godikit-logger-example-slf4j-logback</module>
        <module>godikit-logger-example-slf4j2-logback</module>
    </modules>

