<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.godikit.logger</groupId>
        <artifactId>godikit-logger-parent</artifactId>
        <version>${revision}</version>
        <relativePath>../godikit-logger/pom.xml</relativePath>
    </parent>

    <artifactId>godikit-logger-parent-jdk17</artifactId>
    <version>${revision}</version>
    <packaging>pom</packaging>
    <name>GodiKit Logger Parent (JDK 17)</name>
    <description>Aggregator module for the JDK 17 build of GodiKit Logger, grouping the JDK 17 core API artifact, the
        SLF4J 1.7 and SLF4J 2.x + Logback providers with their default configurations, and the corresponding usage
        examples.
    </description>
    <url>https://www.godikit.com/logger</url>

    <properties>
        <godikit.java.version>17</godikit.java.version>
    </properties>

    <modules>
        <module>godikit-logger-jdk17</module>
        <module>godikit-logger-provider-slf4j-logback-jdk17</module>
        <module>godikit-logger-provider-slf4j-logback-config-jdk17</module>
        <module>godikit-logger-provider-slf4j2-logback-jdk17</module>
        <module>godikit-logger-provider-slf4j2-logback-config-jdk17</module>
        <module>godikit-logger-example-slf4j-logback-jdk17</module>
        <module>godikit-logger-example-slf4j2-logback-jdk17</module>
    </modules>

    <developers>
        <developer>
            <name>Len (田隆)</name>
            <email>len@godikit.com</email>
            <url>https://github.com/lentiancn</url>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://raw.githubusercontent.com/lentiancn/godikit-logger-java/refs/heads/main/LICENSE</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/lentiancn/godikit-logger-java</url>
        <connection>scm:git:https://github.com/lentiancn/godikit-logger-java.git</connection>
        <developerConnection>scm:git:git@github.com:lentiancn/godikit-logger-java.git</developerConnection>
    </scm>
</project>
