<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.godikit.logger</groupId>
        <artifactId>godikit-logger-parent-jdk17</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>godikit-logger-jdk17</artifactId>
    <version>${revision}</version>
    <name>GodiKit Logger (JDK 17)</name>
    <description>JDK 17 build of the core GodiKit Logger API artifact. Exposes the same Logger interface, LoggerFactory
        entry point and LoggerProvider SPI contract as the JDK 8 line, compiled against the JDK 17 variant of
        godikit-exception.
    </description>
    <url>https://www.godikit.com/logger</url>

    <dependencies>
        <dependency>
            <groupId>com.godikit.logger</groupId>
            <artifactId>godikit-logger</artifactId>
        </dependency>
        <dependency>
            <groupId>com.godikit.exception</groupId>
            <artifactId>godikit-exception-jdk17</artifactId>
        </dependency>
    </dependencies>

    <developers>
        <developer>
            <name>Len (田隆)</name>
            <email>len@godikit.com</email>
            <url>https://github.com/lentiancn</url>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://raw.githubusercontent.com/lentiancn/godikit-logger-java/refs/heads/main/LICENSE</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/lentiancn/godikit-logger-java</url>
        <connection>scm:git:https://github.com/lentiancn/godikit-logger-java.git</connection>
        <developerConnection>scm:git:git@github.com:lentiancn/godikit-logger-java.git</developerConnection>
    </scm>
</project>
