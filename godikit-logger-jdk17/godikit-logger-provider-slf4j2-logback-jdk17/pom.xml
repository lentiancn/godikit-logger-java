<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.godikit.logger</groupId>
        <artifactId>godikit-logger-parent-jdk17</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>godikit-logger-provider-slf4j2-logback-jdk17</artifactId>
    <version>${revision}</version>
    <name>GodiKit Logger Provider - SLF4J 2.x + Logback (JDK 17)</name>
    <description>JDK 17 variant of the SLF4J 2.x + Logback provider for GodiKit Logger. Assembles the JDK 17 core API,
        the JDK 17 default Logback configuration and the SLF4J 2.x + Logback backend into a single artifact targeting
        the Java 17 toolchain, with Logback 1.5.x as the underlying implementation.
    </description>
    <url>https://www.godikit.com/logger</url>

    <dependencies>
        <dependency>
            <groupId>com.godikit.logger</groupId>
            <artifactId>godikit-logger-provider-slf4j2-logback</artifactId>
        </dependency>
        <dependency>
            <groupId>com.godikit.logger</groupId>
            <artifactId>godikit-logger-provider-slf4j2-logback-config-jdk17</artifactId>
        </dependency>
        <dependency>
            <groupId>com.godikit.logger</groupId>
            <artifactId>godikit-logger-jdk17</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>1.5.38</version>
        </dependency>
    </dependencies>

    <developers>
        <developer>
            <name>Len (田隆)</name>
            <email>len@godikit.com</email>
            <url>https://github.com/lentiancn</url>
        </developer>
    </developers>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://raw.githubusercontent.com/lentiancn/godikit-logger-java/refs/heads/main/LICENSE</url>
        </license>
    </licenses>

    <scm>
        <url>https://github.com/lentiancn/godikit-logger-java</url>
        <connection>scm:git:https://github.com/lentiancn/godikit-logger-java.git</connection>
        <developerConnection>scm:git:git@github.com:lentiancn/godikit-logger-java.git</developerConnection>
    </scm>
</project>
